# Copy this file to .env and add newly rotated credentials locally.
# Loaded by the FastAPI backend; never served to the browser.
LEAD_SOURCE=firecrawl
APOLLO_API_KEY=

# Choose one provider and set its key.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
GEMINI_API_KEY=

FIRECRAWL_API_KEY=
OUTREACH_OFFER=

# Daily runs are off by default to avoid unexpected provider calls.
SCHEDULER_ENABLED=false
DAILY_TARGET=Dental clinics in Texas
SCHEDULE_HOUR=9
SCHEDULE_TIMEZONE=Asia/Karachi
